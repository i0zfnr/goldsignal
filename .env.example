MARKET_SOURCE=demo
BROKER_SYMBOL=XAUUSD
DATABASE_URL=sqlite:///goldsignal.sqlite3
# DATABASE_URL=mysql+pymysql://goldsignal:password@127.0.0.1:3306/goldsignal?charset=utf8mb4
REPLAY_STEP_SECONDS=5
ENTRY_START=08:00
ENTRY_END=17:00
MAX_SPREAD=0.50
QUOTE_MAX_AGE=20
ENTRY_TTL_MIN=30
HOLD_TTL_MIN=180
SWING_BARS=2
ZONE_WIDTH=0.80
TREND_BARS=4
NEWS_BEFORE_MIN=20
NEWS_AFTER_MIN=15
CALENDAR_MAX_AGE_HOURS=6
HEADLINE_RSS_URLS=
SIGNAL_REVIEW_MODE=rules
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Live mode requires your broker's verified hours, expressed in America/New_York.
MT5_TERMINAL_PATH=
MT5_SERVER_OFFSET_MINUTES=0
BROKER_HOURS=
BROKER_FRIDAY_CLOSE=17:00
BROKER_SUNDAY_OPEN=18:00
BROKER_CLOSED_DATES=
BROKER_DATE_HOURS={}
# Live size estimates require explicit account economics. Set from broker specs.
BROKER_ACCOUNT_CURRENCY=
BROKER_UNITS_PER_CURRENCY=
BROKER_CONVERSION=
BROKER_MARGIN_RATE=
BROKER_COMMISSION=
BROKER_SLIPPAGE=
BROKER_COSTS_AS_OF=
BROKER_COSTS_MAX_AGE_HOURS=24

# Use SECURE_COOKIE=1 behind production HTTPS.
SECURE_COOKIE=0
VAPID_PRIVATE_KEY_FILE=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=
